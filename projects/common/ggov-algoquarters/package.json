{
  "name": "ggov-algoquarters",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Shared AlgoQuarters primitives, and the Reti pools algoquarters pipeline",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "snapshot:reti": "tsx src/reti/snapshot.ts",
    "algoquarters:reti": "tsx src/reti/algoquarters.ts",
    "verify:reti": "tsx src/reti/verify.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "algosdk": "^3.5.2",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "vitest": "^4.1.9"
  }
}
