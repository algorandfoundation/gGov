{
  "name": "ggov-algoquarters",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Compute per-account algoquarters for ALGO liquid-stakers and Reti pools participants",
  "scripts": {
    "snapshot:tinyman": "NODE_OPTIONS=--max-old-space-size=8192 tsx src/tinyman/snapshot.ts",
    "algoquarters:tinyman": "NODE_OPTIONS=--max-old-space-size=8192 tsx src/tinyman/algoquarters.ts",
    "snapshot:reti": "tsx src/reti/snapshot.ts",
    "algoquarters:reti": "tsx src/reti/algoquarters.ts",
    "verify:tinyman": "tsx src/tinyman/verify.ts",
    "verify:reti": "tsx src/reti/verify.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "algosdk": "^3.5.2",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "vitest": "^4.1.9"
  }
}
