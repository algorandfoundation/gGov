    "schema": {
        "global": {
            "declared": {
                "operator": {
                    "type": "bytes",
                    "key": "operator",
                    "descr": "Instance operator; zero address falls back to the registry's `defaultOperator`"
                },
                "registryApp": {
                    "type": "uint64",
                    "key": "registryApp",
                    "descr": "`FracDelegationRegistry` app ID; initialized at creator app ID (defaults to zero if non-app)"
                }
            },
            "reserved": {}
        },
        "local": {
            "declared": {},
            "reserved": {}
        }
    },
    "contract": {
        "name": "FracDelegationInstance",
        "desc": "Fractional Delegation Instance: per-protocol delegation contract.\n\nResolves its admin and operator from the registry global state.",
        "methods": [
            {
                "name": "getAdmin",
                "args": [],
                "readonly": true,
                "returns": {
                    "type": "address"
                }
            },
            {
                "name": "getOperator",
                "args": [],
                "readonly": true,
                "returns": {
                    "type": "address"
                }
            },
            {
                "name": "setOperator",
                "args": [
                    {
                        "type": "address",
                        "name": "newOperator"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Set the `operator` account. Admin only; zero address clears back to registry fallback."
            },
            {
                "name": "setRegistryApp",
                "args": [
                    {
                        "type": "uint64",
                        "name": "appId"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Set the `registryApp` ID. Admin only. Validates the new registry exposes an `admin` key\nbefore binding, so a bad `appId` can't brick role resolution. Note an nonexistent app will\nrevert on `app_global_get_ex`, so new registry must exist and have an `admin` key.\nThis is a migration path for the registry app. Always set the new registry before deleting\nthe old one (if so), never after - as admin auth could be bricked."
            },
            {
                "name": "withdrawALGO",
                "args": [
                    {
                        "type": "address",
                        "name": "receiver",
                        "desc": "Destination account"
                    },
                    {
                        "type": "uint64",
                        "name": "amount",
                        "desc": "microALGO to withdraw"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Withdraw ALGO from the instance app account to `receiver`. Admin only.\nThe AVM rejects the inner payment if it would drop the app account below its min\nbalance, so over-withdrawal fails atomically (no explicit balance check needed)."
            },
            {
                "name": "increaseBudget",
                "args": [
                    {
                        "type": "uint64",
                        "name": "itxns",
                        "desc": "Number of no-op itxns to perform"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Utility to increase opcode budget by performing $itxns no-op itxns"
            }
        ],
        "networks": {}
    },
    "bare_call_config": {
        "update_application": "CALL",
        "delete_application": "CALL",
        "no_op": "CREATE"
    }
}