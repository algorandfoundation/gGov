                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Set the `registryApp` ID. Admin only. Validates the new registry exposes an `admin` key\nbefore binding, so a bad `appId` can't brick role resolution. Note an nonexistent app will\nrevert on `app_global_get_ex`, so new registry must exist and have an `admin` key.\nThis is a migration path for the registry app. Always set the new registry before deleting\nthe old one (if so), never after - as admin auth could be bricked.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "withdrawALGO",
            "args": [
                {
                    "type": "address",
                    "name": "receiver",
                    "desc": "Destination account"
                },
                {
                    "type": "uint64",
                    "name": "amount",
                    "desc": "microALGO to withdraw"
                }
            ],
            "returns": {
                "type": "void"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Withdraw ALGO from the instance app account to `receiver`. Admin only.\nThe AVM rejects the inner payment if it would drop the app account below its min\nbalance, so over-withdrawal fails atomically (no explicit balance check needed).",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "registerEscrow",
            "args": [
                {
                    "type": "address",
                    "name": "account",
                    "desc": "Escrow account to append"
                }
            ],
            "returns": {
                "type": "void"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Append `account` to this instance's `escrows` list. Callable by the bound registry (the\nnormal path \u2014 `FracDelegationRegistry.registerEscrow`, which also keeps its per-instance\n`numEscrows` counter in sync) or directly by the admin (escape hatch; a direct admin call\ndoes NOT touch the registry counter, so prefer the registry path).\n\nAppend-only: this method performs no de-duplication. On the normal path the registry\nenforces globally-unique escrow assignment before calling here, so duplicates only arise if\nthe admin uses the direct escape hatch to register the same account twice.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "increaseBudget",
            "args": [
                {
                    "type": "uint64",
                    "name": "itxns",
                    "desc": "Number of no-op itxns to perform"
                }
            ],
            "returns": {
                "type": "void"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Utility to increase opcode budget by performing $itxns no-op itxns",
            "events": [],
            "recommendations": {}
        }
