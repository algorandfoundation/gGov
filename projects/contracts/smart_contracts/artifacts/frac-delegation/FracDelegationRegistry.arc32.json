    "schema": {
        "global": {
            "declared": {
                "admin": {
                    "type": "bytes",
                    "key": "admin",
                    "descr": "Admin address; defaults to creator. Rotatable via `setAdmin`."
                },
                "defaultOperator": {
                    "type": "bytes",
                    "key": "defaultOperator",
                    "descr": "Fallback operator for frac instances; defaults to creator"
                },
                "gGovRegistryApp": {
                    "type": "uint64",
                    "key": "gGovRegistryApp",
                    "descr": "gGov registry application ID"
                },
                "lastAccountId": {
                    "type": "uint64",
                    "key": "lastAccountId",
                    "descr": "Last account numeric ID"
                },
                "lastInstanceNumId": {
                    "type": "uint64",
                    "key": "lastInstanceNumId",
                    "descr": "Last account numeric ID"
                }
            },
            "reserved": {}
        },
        "local": {
            "declared": {},
            "reserved": {}
        }
    },
    "contract": {
        "name": "FracDelegationRegistry",
        "desc": "Fractional Delegation Registry: global singleton, instance deployer.\n\nHolds the frac-system-wide admin and the default operator inherited by instance contracts.\nInstance contracts resolve their roles by reading this registry's global state directly.",
        "methods": [
            {
                "name": "setAdmin",
                "args": [
                    {
                        "type": "address",
                        "name": "newAdmin"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Transfer admin to `newAdmin`. Admin only; zero address rejected."
            },
            {
                "name": "setDefaultOperator",
                "args": [
                    {
                        "type": "address",
                        "name": "newDefaultOperator"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Set the `defaultOperator` account. Admin only."
            },
            {
                "name": "setGGovRegistryApp",
                "args": [
                    {
                        "type": "uint64",
                        "name": "appId"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Set the gGov registry application ID. Admin only."
            },
            {
                "name": "withdrawALGO",
                "args": [
                    {
                        "type": "address",
                        "name": "receiver",
                        "desc": "Destination account"
                    },
                    {
                        "type": "uint64",
                        "name": "amount",
                        "desc": "microALGO to withdraw"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Withdraw ALGO from the registry app account to `receiver`. Admin only.\nThe AVM rejects the inner payment if it would drop the app account below its min\nbalance, so over-withdrawal fails atomically (no explicit balance check needed)."
            },
            {
                "name": "uploadInstanceApprovalPartial",
                "args": [
                    {
                        "type": "uint64",
                        "name": "startOffset"
                    },
                    {
                        "type": "byte[]",
                        "name": "data"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Upload (or re-upload) a chunk of the FracDelegationInstance approval bytecode into\na registry box. Admin only. `startOffset === 0` deletes the existing box and creates\na fresh one at the chunk length; subsequent chunks resize/replace."
            },
            {
                "name": "createInstance",
                "args": [
                    {
                        "type": "string",
                        "name": "name",
                        "desc": "Instance label for reference."
                    },
                    {
                        "type": "pay",
                        "name": "mbrPayment",
                        "desc": "Payment txn covering the new period app's MBR. Receiver must be this registry's address."
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "(uint16,uint64)",
                    "desc": "[instanceNumId, appId]"
                },
                "desc": "Spawn a fresh frac-instance app. Admin only."
            },
            {
                "name": "increaseBudget",
                "args": [
                    {
                        "type": "uint64",
                        "name": "itxns",
                        "desc": "Number of no-op itxns to perform"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Utility to increase opcode budget by performing $itxns no-op itxns"
            }
        ],
        "networks": {}
    },
    "bare_call_config": {
        "update_application": "CALL",
        "delete_application": "CALL",
        "no_op": "CREATE"
    }
}