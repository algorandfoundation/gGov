# Copied to .env by `algokit project bootstrap env` (run from this directory). Loaded by 
# `algokit project deploy <network>`, which layers .env.<network> (localnet|testnet|mainnet) 
# on top of .env — put network-specific values (e.g. mainnet app ids, DEPLOYER_MNEMONIC) in 
# those files, never in version control.

# Node endpoints, read by AlgorandClient.fromEnvironment(). Keep commented to use the defaults:
# `algokit project deploy <network>` injects localnet/testnet/mainnet endpoints (Nodely free tier
# for public networks). Uncomment only for a custom node/provider.
# ALGOD_SERVER=
# ALGOD_PORT=
# ALGOD_TOKEN=
# INDEXER_SERVER=
# INDEXER_PORT=
# INDEXER_TOKEN=

# App ids for the registry wiring step (smart_contracts/wire-registries.ts), all optional and
# re-settable on redeploy. See "Registry wiring" in README.md.

# Existing xGov registry, wired into GGovRegistry.xGovRegistryApp. Env only: this repo never
# deploys an xGov registry. Leave empty to skip (fresh localnet has none).
XGOV_REGISTRY_APP_ID=

# Existing GGovRegistry / FracDelegationRegistry, wired into each other. Leave empty unless you
# need to point at an app the DEPLOYER did not create: the wiring step already prefers apps
# deployed by the current run, then falls back to apps of that name created by the DEPLOYER.
GGOV_REGISTRY_APP_ID=
FRAC_REGISTRY_APP_ID=
