{
  "name": "sdk-shared",
  "version": "0.0.1",
  "description": "Group sizing shared by ggov-sdk and frac-delegation-sdk: opcode budget, reference slots and AVM v13 usage fees",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/algorandfoundation/gGov.git"
  },
  "bugs": {
    "url": "https://github.com/algorandfoundation/gGov/issues"
  },
  "homepage": "https://github.com/algorandfoundation/gGov/tree/main/projects/sdk-shared#readme",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:cjs && pnpm run build:dist-pkg",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:dist-pkg": "node scripts/write-dist-package-json.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@algorandfoundation/algokit-utils": "^9.2.0",
    "algosdk": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.10"
  }
}
