{
  // Cloudflare Worker configuration for the TanStack Start app.
  // `wrangler deploy` (run after `vite build`) deploys the server entry plus the
  // built client assets emitted by @cloudflare/vite-plugin.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ggov-frontend",
  "compatibility_date": "2026-06-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true
  },
  // Per-network Worker deployments. Network config is baked in at build time
  // (`vite build --mode testnet|mainnet` inlines the VITE_* vars), so testnet and
  // mainnet are separate Workers. With @cloudflare/vite-plugin the Cloudflare
  // environment is selected at BUILD time via CLOUDFLARE_ENV (the plugin writes a
  // redirected dist/server/wrangler.json), then a plain `wrangler deploy` ships it —
  // `wrangler deploy --env` is NOT honored. See the deploy:* scripts in package.json.
  // Top-level main/compatibility_*/observability are inherited by each environment.
  "env": {
    "testnet": { "name": "ggov-frontend-testnet" },
    "mainnet": { "name": "ggov-frontend-mainnet" }
  },
  // Secrets (NOT committed here — `vars` would be public). Set server-only secrets
  // via the CLI so they never touch the dashboard or the client bundle. Secrets are
  // per-environment, so scope with `--env` to hit the right Worker — a bare
  // `secret put` targets the unused top-level `ggov-frontend`:
  //   pnpm wrangler secret put ALGOD_TOKEN --env testnet   # testnet worker
  //   pnpm wrangler secret put ALGOD_TOKEN --env mainnet   # mainnet worker
  //   echo 'ALGOD_TOKEN=...' >> .dev.vars                  # local dev (see .dev.vars.example)
  // ALGOD_TOKEN is the privileged Algod token used for SSR chain reads on the
  // Worker (src/lib/serverReaderSdk.ts).
}
