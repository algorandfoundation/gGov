# ======================
# LocalNet configuration
# ======================

VITE_ALGOD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
VITE_ALGOD_SERVER=http://localhost
VITE_ALGOD_PORT=4001
VITE_ALGOD_NETWORK=localnet

VITE_INDEXER_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
VITE_INDEXER_SERVER=http://localhost
VITE_INDEXER_PORT=8980

VITE_KMD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
VITE_KMD_SERVER=http://localhost
VITE_KMD_PORT=4002
VITE_KMD_WALLET="unencrypted-default-wallet"
VITE_KMD_PASSWORD=""

# GGov Registry App ID (set after deploying the contract)
VITE_GGOV_REGISTRY_APP_ID=1002

# Escreg (escrow registry) App ID for app-escrow lookups on /account pages.
# Optional — leave unset to use the SDK's built-in Fnet registry.
# VITE_ESCREG_APP_ID=

# Fractional-delegation registry App ID, for pooled voting power (xALGO / tALGO / Reti).
# Optional — leave unset on networks with no frac deployment. When unset the app
# issues no pooled queries at all and every surface shows direct power only.
# VITE_FRAC_REGISTRY_APP_ID=


