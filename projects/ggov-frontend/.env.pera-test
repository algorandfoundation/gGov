# ============================================
# Pera test configuration (TestNet via Nodely)
# ============================================
#
# Public preview environment for testing wallet flows (Pera, Defly, Lute,
# Exodus) from a deployed URL. Mobile wallets can't reach a localhost dev
# server, so this points at TestNet and is meant to be served from the
# Cloudflare Pages `pera-test` preview branch:
#
#   pnpm pages:deploy:pera-test
#
# Any non-localnet network enables the Pera/Defly/Exodus/Lute wallet set
# (see src/App.tsx).

VITE_ALGOD_TOKEN=
VITE_ALGOD_SERVER=https://testnet-api.4160.nodely.dev
VITE_ALGOD_PORT=443
VITE_ALGOD_NETWORK=testnet

VITE_INDEXER_TOKEN=
VITE_INDEXER_SERVER=https://testnet-idx.4160.nodely.dev
VITE_INDEXER_PORT=443

# GGov Registry App ID (TestNet)
VITE_GGOV_REGISTRY_APP_ID=764219812
